{
  "name": "luminaul-backend",
  "version": "1.0.0",
  "description": "LuminaUL Backend in NestJS",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "db:init": "ts-node scripts/init-db.ts",
    "test": "vitest run --config vitest.config.mts",
    "test:watch": "vitest --config vitest.config.mts",
    "test:unit": "vitest run --config vitest.config.mts",
    "test:e2e": "vitest run --config vitest.config.e2e.mts test/e2e-integration.spec.ts",
    "test:ws": "vitest run --config vitest.config.e2e.mts test/websockets-chat.spec.ts",
    "test:security": "vitest run --config vitest.config.e2e.mts test/security-owasp.spec.ts",
    "test:all": "vitest run --config vitest.config.mts && vitest run --config vitest.config.e2e.mts",
    "test:cov": "vitest run --config vitest.config.mts --coverage"
  },
  "dependencies": {
    "@nestjs/common": "^12.3.2",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.3.2",
    "@nestjs/event-emitter": "^12.0.1",
    "@nestjs/platform-express": "^12.3.2",
    "@nestjs/platform-socket.io": "^12.3.2",
    "@nestjs/swagger": "^12.0.1",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/typeorm": "^12.0.1",
    "@nestjs/websockets": "^12.3.2",
    "@types/bcryptjs": "2.4.6",
    "bcryptjs": "3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.7",
    "helmet": "^8.3.0",
    "nodemailer": "10.2.1",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.4",
    "typeorm": "^0.3.20",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.3",
    "@nestjs/schematics": "^12.0.3",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "@vitest/coverage-v8": "^5.1.0",
    "socket.io-client": "^4.8.4",
    "source-map-support": "^0.5.21",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
