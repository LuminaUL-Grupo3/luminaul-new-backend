# Entorno de ejecución (development | production | test)
NODE_ENV=development

# Puerto del servidor (por defecto 8000)
PORT=8000

# Conexión a base de datos PostgreSQL
# Reemplazar con tus credenciales: postgresql://usuario:contraseña@localhost:5432/nombre_bd
DATABASE_URL=postgresql://luminaul:luminaul@localhost:5432/luminaul

# Secreto para firmar/verificar JWT (HS256), minimo 16 caracteres
JWT_SECRET=cambiar-por-un-secreto-largo

# Clave de API de OpenAI para Moderación Semántica (SPEC-06, opcional: si está vacía, opera en fallback a filtro léxico)
OPENAI_API_KEY=tu-api-key-de-openai-aqui

# Correo de SPEC-01 (códigos de verificación y recuperación de contraseña)
# console: imprime el código en el log (desarrollo) | smtp: envía correos reales
MAIL_TRANSPORT=console
# TEMPORAL: reemplazar con las credenciales reales del remitente antes de usar MAIL_TRANSPORT=smtp
SMTP_HOST=smtp.ejemplo.com
# 587 = STARTTLS (SMTP_SECURE=false) | 465 = TLS directo (SMTP_SECURE=true)
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=remitente@ejemplo.com
SMTP_PASSWORD=cambiar-por-la-contraseña-de-aplicación
MAIL_FROM="LuminaUL <remitente@ejemplo.com>"