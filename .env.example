# Entorno de ejecución (development | production | test)
NODE_ENV=development

# Puerto del servidor (por defecto 8000)
PORT=8000

# Conexión a base de datos PostgreSQL
# Reemplazar con tus credenciales: postgresql://usuario:contraseña@localhost:5432/nombre_bd
DATABASE_URL=postgresql://luminaul:luminaul@localhost:5432/luminaul

# Secreto para firmar/verificar JWT (HS256), minimo 16 caracteres
JWT_SECRET=cambiar-por-un-secreto-largo
WEB_ORIGIN=http://localhost:5173

# Buzón local Mailpit: http://localhost:8026; sustituir por SMTP real para correo externo
MAIL_HOST=127.0.0.1
MAIL_PORT=11026
MAIL_SECURE=false
MAIL_FROM=LuminaUL <no-reply@luminaul.local>
# MAIL_USER=
# MAIL_PASSWORD=
